<div class="example-container">
  <mat-sidenav-container class="example-sidenav-container">
    <mat-sidenav-content style="background-color:#eaeaea">
      <div class="mainDiv"> 
        <div *ngIf="readonlymode" style="padding : 15px">
          <div class="row tabheader">
            <div style="float: right; padding-right: 10px;">
              <a id="filter" class="maticonbutton" title="{{toggletext}} Filter" (click)="toggleFilterOnClick()">
                <mat-icon style="vertical-align: middle">filter_list</mat-icon>
              </a> 
            </div>
            <div style="float: left; ">
                <div class="backbuttonlink" [routerLink]="['/newdashboard/cust', selectedCust, false]">
                  <img src="assets/images/back_round.png">
                </div>
              <img class="image" style="height:45px;padding:5px" src="assets/images/{{selectedCust}}.png" onerror="this.src ='assets/images/CustomerLogo.png'">
            </div>
          </div>
         
          <div style="margin-bottom: 10px;" >
              <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6" *ngIf="bShowFilter" style="text-align: left;">
                  <!-- <app-portfolio-project-selector [custId]="selectedCust" [portinput]="sharedService.selectedPortfolios"
                    [projinput]="sharedService.selectedProjects" [allproj]="false" (projectsSelected)="projectSelected($event)">
                  </app-portfolio-project-selector> -->
                </div>
                  <div class="col-lg-5 col-md-5 col-sm-5" style="text-align: left;padding-top: 20px;">
                      <label class="openItemsFilter">Status :</label>
                      <mat-checkbox class="example-margin" color="blue" [(ngModel)]="AllChecked" 
                            (ngModelChange)="showFilteredRows()" (click)="uncheckOthers()">All</mat-checkbox>
                      <mat-checkbox class="example-margin" color="blue" [(ngModel)]="PastDueChecked" [disabled]="AllChecked"
                            (ngModelChange)="showFilteredRows()">Open - Past Due Date</mat-checkbox>
                      <mat-checkbox class="example-margin" color="blue" [(ngModel)]="DueClosureChecked" [disabled]="AllChecked"
                            (ngModelChange)="showFilteredRows()">Open - Due For Closure</mat-checkbox>
                    </div>
                  <div class="col-lg-1 col-md-1 col-sm-1">
        
                  </div>
              </div>
        </div>
          <div class="row" *ngIf="bShowFilter">
            <!-- <app-table-filter [data]="input" tableName='EVENT_TASK_DETAILS' (onChange)="filterOnChange($event)" (OnAdd)="showAll($event)"></app-table-filter> -->
          </div>
          <div class="backbutton">
            <div style="display: inline-block; ">
             <b>{{periodTitle}}</b> 
            </div>
          </div>
          <div>
            <div *ngIf="input?.length == 0" style="text-align: center;height: 100px; line-height: 100px; font-size: 16px; font-weight: 600;;">
              No Events or Tasks for the Projects assigned to you..
            </div>
          </div>  
          <div>
            <div *ngIf="!input" style="text-align: center; height: 100px; line-height: 100px;">
                <i class="fa fa-circle-o-notch fa-spin" style="margin-right: 10px; font-size: 25px;"></i>Loading...
            </div>
          </div>
          <div>
            <table class="table" mat-table style="border-radius: 3px;overflow: hidden ; font-family: 'Roboto', sans-serif" #table [dataSource]="dataSource"  *ngIf="input?.length > 0"
              matSort>
              <ng-container matColumnDef="index">
                <th mat-header-cell style="font-family: calibri; width: 15px;" *matHeaderCellDef>No.</th>
                <td mat-cell *matCellDef="let element = index; let issue" [ngClass]="{'greenborder': issue.severity == 'Low', 'orangeborder' : issue.severity == 'Medium',
                'redborder' : issue.severity == 'High'}"> {{element + 1}} </td>
              </ng-container>
              <ng-container matColumnDef="description">
                <th mat-header-cell style="font-family: calibri; width : 150px; " *matHeaderCellDef mat-sort-header>description</th>
                <td mat-cell *matCellDef="let issue" >{{issue.description}}</td>
              </ng-container>
              <ng-container matColumnDef="projectName">
                <th mat-header-cell style="font-family: calibri; width : 200px;" *matHeaderCellDef mat-sort-header>Project Name</th>
                <td mat-cell *matCellDef="let issue" >{{issue.projectName}}</td>
              </ng-container>
              <ng-container matColumnDef="taskType">
                <th mat-header-cell style="font-family: calibri; width: 40px;" *matHeaderCellDef mat-sort-header>Task Type</th>
                <td mat-cell *matCellDef="let issue" > {{issue.taskType}} </td>
              </ng-container>
              <ng-container matColumnDef="priority">
                <th mat-header-cell style="font-family: calibri; width: 30px;" *matHeaderCellDef mat-sort-header>priority</th>
                <td mat-cell *matCellDef="let issue"> {{issue.priority}} </td>
              </ng-container>
              <ng-container matColumnDef="taskCategory">
                <th mat-header-cell style="font-family: calibri;width: 120px;" *matHeaderCellDef mat-sort-header>Category</th>
                <td mat-cell *matCellDef="let issue" > {{issue.taskCategory}} </td>
              </ng-container>
              <ng-container matColumnDef="dueDate">
                <th mat-header-cell style="font-family: calibri;width: 80px;" *matHeaderCellDef mat-sort-header>Due Date</th>
                <td mat-cell *matCellDef="let issue"> {{issue.dueDate | date :'dd-MMM-yyyy'}} </td>
              </ng-container>
              <ng-container matColumnDef="status">
                <th mat-header-cell style="font-family: calibri; width: 50px;" *matHeaderCellDef mat-sort-header>Status</th>
                <td mat-cell *matCellDef="let issue"> {{issue.status}} </td>
              </ng-container> 
              <tr mat-header-row *matHeaderRowDef="displayedColumns" class="mat-elevation-z5"></tr>
              <tr mat-row *matRowDef="let row; columns: displayedColumns;" class="mat-elevation-z5" style="margin-bottom: 5px; box-sizing: border-box"></tr>
            </table>
            <mat-paginator #paginator [pageSize]="5" [pageSizeOptions]="[5, 10, 20]"></mat-paginator>
          </div>
        </div> 
      </div>
    </mat-sidenav-content>
  </mat-sidenav-container>
</div>
  
