.greenborder{
  border-left: 5px solid green;
}

.orangeborder{
  border-left: 5px solid orange;
}

.redborder{
  border-left: 5px solid red;
}

.col-lg-12, .col-md-12, .col-sm-12,  .col-lg-5, .col-md-5, .col-sm-5, .col-lg-6, .col-md-6, .col-sm-6
{
    padding-left: 0px !important;
    padding-right: 0px !important;
}
.backbuttonlink{ float: left;}
.mat-cell
{
  font-size: 11px !important;
  word-break: break-word;
}
.mat-column-index{
  width: 1% !important;
}
.mainDiv{
  border-radius: 9px;
  margin: 5px 10px;
  min-height: 600px;
  overflow: auto;
  box-shadow: 1px 2px 3px 1px #c7c7c7;
   background-color: white;
}
.mat-column-description {
  width: 30% !important;
}
.mat-column-targeT_DATE,.mat-column-identifieD_DATE, .mat-column-issuE_RESOLVED_DATE {
  width: 8% !important;
  white-space: nowrap;
}

.mat-column-portfoliO_NM{
    width: 18% !important;
}

.mat-column-proJ_NM{
    width: 18% !important;
}

.mat-column-Priority,.mat-column-Status, .mat-column-severitY {
  width: 5% !important;
  word-break: unset
}

.mat-column-issuE_TYPE{
  width: 10% !important;
}

.mat-column-actioN_PLAN{
  width: 25% !important;
}

.mat-radio-button ~ .mat-radio-button {
  margin-left: 12px;
}

::ng-deep .mat-checkbox-checked .mat-checkbox-background, .mat-checkbox-indeterminate .mat-checkbox-background {
  background-color:#005691!important;
}

.openItemsFilter ~ .mat-checkbox{
  margin-left: 12px;
}

div.user_options {display: none !important;}
