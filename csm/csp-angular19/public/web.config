<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cache policy for the CSM Angular app.

  Why this file exists:
  Without it, browsers (and any caching proxy in front of IIS) can keep serving an old,
  cached copy of index.html after a new build is deployed. Since index.html is what
  references the current content-hashed bundles (e.g. main-Q5TBYIVF.js,
  chunk-2JSNJ6UC.js, styles-GYCB2DRJ.css), a stale cached index.html keeps loading the
  OLD JavaScript even after a new build with new filenames was deployed — forcing
  users to manually clear their browser cache after every release.

  Fix: never cache index.html (always revalidate with the server), but cache the
  content-hashed JS/CSS bundles forever, since Angular's build (outputHashing: "all")
  gives every bundle a new filename whenever its content changes, so there is never a
  correctness risk in caching those long-term — an old cached bundle is simply never
  referenced again by the new index.html.

  This file lives in public/ so `ng build` copies it into the output root automatically
  on every build (see the "assets" entry for "public" in angular.json), landing right
  next to index.html with no manual server changes required after each deploy.

  Note: the CSAT Analysis Dashboard micro-app (served under /csat-analysis-dashboard)
  has its OWN nested web.config with the same policy, scoped to its own build output
  shape (bundles under static/js, static/css). IIS applies that nested config for
  requests under that subfolder, so it is unaffected by the rules below.
-->
<configuration>
  <system.webServer>

    <!-- Default: cache all static output aggressively. Angular content-hashes every
         JS/CSS bundle filename, so a new build always produces new filenames and an
         old cached file is simply never referenced again — never served stale. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="public, max-age=31536000, immutable" />
      </customHeaders>
    </httpProtocol>

    <!-- index.html is the one file whose NAME never changes between builds, so it
         must always be revalidated — otherwise browsers keep loading an old
         index.html that still points at the previous (now-stale) bundle filenames. -->
    <location path="index.html">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="DisableCache" />
        </staticContent>
        <httpProtocol>
          <customHeaders>
            <remove name="Cache-Control" />
            <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
            <remove name="Pragma" />
            <add name="Pragma" value="no-cache" />
            <remove name="Expires" />
            <add name="Expires" value="-1" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>

    <!-- Non-hashed static assets (images, uploaded logos, etc. copied verbatim from
         src/assets) can change without a filename change, so don't cache them as
         aggressively as the hashed bundles — a short revalidation window instead. -->
    <location path="assets">
      <system.webServer>
        <staticContent>
          <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
        </staticContent>
        <httpProtocol>
          <customHeaders>
            <remove name="Cache-Control" />
            <add name="Cache-Control" value="public, max-age=86400" />
          </customHeaders>
        </httpProtocol>
      </system.webServer>
    </location>

  </system.webServer>
</configuration>
