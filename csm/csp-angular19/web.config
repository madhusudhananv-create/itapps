<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.web>
    <customErrors mode="Off"/>
  </system.web>

  <system.webServer>

    <rewrite>
      <rules>

        <!-- Serve standalone dashboard files directly -->
        <rule name="Pipeline Dashboards" stopProcessing="true">
          <match url="^pipeline_.*\.html$" />
          <action type="None" />
        </rule>

        <!-- Proxy ALL /pipeline-healthcare/* requests to Node.js -->
        <!-- Node.js servePipelineDataFile picks the latest file from each folder -->
        <rule name="Proxy Pipeline Data" stopProcessing="true">
          <match url="^pipeline-healthcare/(.*)" />
          <action type="Rewrite" url="http://localhost:8080/pipeline-healthcare/{R:1}" />
        </rule>

        <!-- Proxy Node API (pull-and-load, load-files, list-folder, etc.) -->
        <rule name="Proxy Node API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:8080/api/{R:1}" />
        </rule>

        <!-- Handle /aimi subfolder routing -->
        <rule name="AIMI Subfolder Routes" stopProcessing="true">
          <match url="^aimi/(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="aimi/index.html" />
        </rule>

        <!-- Handle main application routes -->
        <rule name="Main App Routes" stopProcessing="true">
          <match url="^(?!aimi/)(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

      </rules>

      <!-- Cache fix: set Cache-Control by matching the response URL/extension directly,
           via URL Rewrite outbound rules. This does NOT use <location> (which caused an
           Internal Server Error here — likely a locked/non-application-root config
           restriction) and does NOT touch <httpProtocol>/<staticContent> at all, so it
           carries much lower risk of breaking the site than the previous attempt.

           - index.html never changes name between builds, so it must always be
             revalidated — otherwise browsers keep loading an old index.html that still
             points at the previous (now-stale) bundle filenames.
           - Angular's hashed JS/CSS bundles (main-XXXX.js, chunk-XXXX.js,
             styles-XXXX.css, polyfills-XXXX.js) get a new filename every build, so
             caching them for a year is always safe. -->
      <outboundRules>
        <rule name="No-Cache for index.html">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="index\.html$" />
          </conditions>
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <rule name="Long Cache for hashed JS/CSS bundles">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{URL}" pattern="\.(js|mjs|css)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
      </outboundRules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="application/font-ttf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

  </system.webServer>

</configuration>
