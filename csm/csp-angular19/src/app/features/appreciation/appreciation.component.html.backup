<div style="padding: 15px" *ngIf="readonlymode">
  <div class="row" style="margin-bottom: 10px;">
    <div class="col-lg-6 col-md-6 col-sm-6" style="text-align: left;">
      <div style="display: inline-block; margin-right: 10px; cursor: pointer; text-decoration: none; outline: none"
        [routerLink]="['/newdashboard/cust', selectedCust, false]">
        <img src="assets/images/back_round.png">
      </div>
      <img class="image" style="height:45px;padding:5px" src="assets/images/{{selectedCust}}.png"
        onerror="this.src ='assets/images/CustomerLogo.png'">
    </div>
    <div class="col-lg-6 col-md-6 col-sm-6" style="text-align:right">
      <a class="iconbutton" title="Export to Excel" (click)="ExportTOExcel()">
        <i style="color: #239958;" class="fa fa-file-excel"></i>
      </a>
      <a class="maticonbutton" title="Add Appreciation" (click)="Edit_onClick()" *ngIf="_access.IsAllowed(86, 2, '', '')">
        <mat-icon style="vertical-align: middle">add</mat-icon>
      </a>
    </div>
  </div>

  <!-- TODO: Uncomment when portfolio-project-selector component is available -->
  <!-- <div style="margin-bottom: 10px;">
    <div class="row">
      <div class="col-lg-6 col-md-6 col-sm-6" *ngIf="bShowFilter" style="text-align: left;">
        <app-portfolio-project-selector [custId]="selectedCust" [portinput]="_shared.selectedPortfolios"
          [projinput]="_shared.selectedProjects" [allproj]="false" (projectsSelected)="projectSelected($event)">
        </app-portfolio-project-selector>
      </div>
    </div>
  </div> -->

  <div style="font-size: 16px; font-weight: 700;font-family: 'Roboto', sans-serif; margin-bottom: 15px;color: #4e5882">
    <div style="display: inline-block; ">
      Appreciation
    </div>
  </div>

  <div *ngIf="_access.IsAllowed(86, 1, '', '')">
    <div *ngIf="result?.length == 0"
      style="text-align: center;height: 100px; line-height: 100px; font-size: 16px; font-weight: 600;;">
      No Appreciation defined for the Projects assigned to you..
    </div>
  </div>

  <div *ngIf="_access.IsAllowed(86, 1, '', '')">
    <div *ngIf="!result" style="text-align: center; height: 100px; line-height: 100px;">
      <i class="fa fa-circle-o-notch fa-spin" style="margin-right: 10px; font-size: 25px;"></i>Loading...
    </div>
  </div>

  <div #TABLE *ngIf="_access.IsAllowed(86, 1, '', '')">
    <table class="table" mat-table #table [dataSource]="dataSource" matSort style="width: 100%"
      *ngIf="result && result.length > 0">
      <ng-container matColumnDef="index">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'indexWidth'" *matHeaderCellDef mat-sort-header>SNo.
        </th>
        <td mat-cell *matCellDef="let element = index; let Item"> {{element + 1}} </td>
      </ng-container>
      <ng-container matColumnDef="proJ_NM">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'projWidth'" *matHeaderCellDef mat-sort-header>
          Project</th>
        <td mat-cell *matCellDef="let Item" [matTooltip]="Item.proJ_NM">{{Item.proJ_NM}}</td>
      </ng-container>
      <ng-container matColumnDef="portfoliO_NAME">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'portWidth'" *matHeaderCellDef mat-sort-header>
          Portfolio Name</th>
        <td mat-cell *matCellDef="let Item" [matTooltip]="Item.portfoliO_NAME">{{Item.portfoliO_NAME}}
        </td>
      </ng-container>
      <ng-container matColumnDef="appreciateD_BY">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'desWidth'" *matHeaderCellDef mat-sort-header>
          Appreciated By</th>
        <td mat-cell *matCellDef="let Item" [matTooltip]="Item.appreciateD_BY"> {{Item.appreciateD_BY}}
        </td>
      </ng-container>
      <ng-container matColumnDef="designation">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'ownerWidth'" *matHeaderCellDef mat-sort-header>
          Designation</th>
        <td mat-cell *matCellDef="let Item"> {{Item.designation}} </td>
      </ng-container>
      <ng-container matColumnDef="comments">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'idendateWidth'" *matHeaderCellDef mat-sort-header>
          Comments</th>
        <td mat-cell *matCellDef="let Item"> {{Item.comments}} </td>
      </ng-container>
      <ng-container matColumnDef="recipienT_NM">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'statusWidth'" *matHeaderCellDef mat-sort-header>
          Recipient</th>
        <td mat-cell *matCellDef="let Item"> {{Item.recipienT_NM}} </td>
      </ng-container>
      <ng-container matColumnDef="receiveD_DATE">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'idendateWidth'" *matHeaderCellDef mat-sort-header>
          Received Date</th>
        <td mat-cell *matCellDef="let Item"> {{Item.receiveD_DATE | date :'dd-MMM-yyyy'}} </td>
      </ng-container>
      <ng-container matColumnDef="info">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'deleteWidth'" *matHeaderCellDef>
          <div *ngIf="_access.IsAllowed(86, 3, '', '')"></div>
        </th>
        <td mat-cell [ngClass]="'deleteWidth'" *matCellDef="let element">
          <a class="link" (click)="OpenEntityInfoPopup(element)" 
          style="font-size: 18px; cursor: pointer;">
          <i class="fa fa-exclamation-circle" style="transform: rotate(180deg);"></i>
          </a>
        </td>
      </ng-container>
      <ng-container matColumnDef="edit">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'deleteWidth'" *matHeaderCellDef>
          <div *ngIf="_access.IsAllowed(86, 3, '', '')"></div>
        </th>
        <td mat-cell [ngClass]="'deleteWidth'" *matCellDef="let Item">
          <a class="link" (click)="EditRow_onClick(Item)" *ngIf="_access.IsAllowed(86, 3, '', '')"
            style="font-size: 18px; cursor: pointer;">
            <i class="fa fa-edit"></i>
          </a>
        </td>
      </ng-container>
     
      <ng-container matColumnDef="delete" class="z-depth-2">
        <th mat-header-cell style="font-family: calibri;" [ngClass]="'deleteWidth'" *matHeaderCellDef>
          <div *ngIf="_access.IsAllowed(86, 4, '', '')"></div>
        </th>
        <td mat-cell [ngClass]="'deleteWidth'" *matCellDef="let element">
          <a class="link" (click)="DeleteRow_onClick(element)" *ngIf="_access.IsAllowed(86, 4, '', '')"
            style="font-size: 18px; cursor: pointer;color:red">
            <i class="fa fa-trash"></i>
          </a>
        </td>
      </ng-container>
      <tr mat-header-row *matHeaderRowDef="displayedColumns" class="mat-elevation-z5"></tr>
      <tr mat-row *matRowDef="let row; columns: displayedColumns;" class="mat-elevation-z5"
        style="margin-bottom: 5px; box-sizing: border-box"></tr>
    </table>
    <div>
      <mat-paginator #paginator [pageSize]="5" [pageSizeOptions]="[5, 10, 20]"></mat-paginator>
    </div>
  </div>
</div>

<div *ngIf="editmode">
  <form style="background: white;padding-left: 10px;padding-bottom: 10px;" #actionitemForm="ngForm"
    (ngSubmit)="SubmitForm(actionitemForm.valid)">
    <div class="row tabheader">
      <div class="col-lg-10 col-md-10 col-sm-10">
      </div>
      <div class="col-lg-2 col-md-2 col-sm-2 header">
        <button class="link_button" type="submit" style="margin-right: 10px;">
          <i class="fa fa-save"></i>
        </button>
        <a class="link" (click)="Cancel_onClick()" style="cursor: pointer;">
          <i class="fa fa-times"></i>
        </a>
      </div>
    </div>
    <div>
      <div class="row">
        <mat-form-field appearance="outline" style="width:44%">
          <mat-label>Project Name</mat-label>
          <mat-select name="ddProjectName" [(ngModel)]="editItem.proJ_ID" required
            (ngModelChange)="getotherDetails()">
            <mat-option [value]="p.proJ_ID" *ngFor="let p of projNames" [title]="p.proJ_NM">
              {{ p.proJ_NM }}
            </mat-option>
          </mat-select>
        </mat-form-field>
      </div>
      <div class="row">
        <mat-form-field appearance="outline" style="width:30%">
          <mat-label>Appreciated By</mat-label>
          <textarea name='txtappreciatedBy' maxlength="100" [(ngModel)]="editItem.appreciateD_BY" matInput
            (keypress)="numberOnly($event)" required></textarea>
        </mat-form-field>
      </div>
      <div class="row">
        <mat-form-field appearance="outline" style="width:30%">
          <mat-label>Designation</mat-label>
          <textarea name='txtappreciatedDesignation' maxlength="225" [(ngModel)]="editItem.designation" matInput
          (keypress)="numberOnly($event)"></textarea>
        </mat-form-field>
      </div>
      <div class="row">
        <mat-form-field appearance="outline" style="width:30%">
          <mat-label>Recipient</mat-label>
          <mat-select name="ddOwner" [(ngModel)]="editItem.recipient" required>
            <mat-option value="Team">Team</mat-option>
            <mat-option [value]="recipient.emP_ID" *ngFor="let recipient of ownerList">{{recipient.frsT_NM}}</mat-option>
          </mat-select>
        </mat-form-field>
      </div>

      <div class="row">
        <mat-form-field appearance="outline" style="width:30%">
          <mat-label>Received Date</mat-label>
          <input [max]="_util.Today()" matInput name="dtAppreciationReceivedDate" [(ngModel)]="editItem.receiveD_DATE"
            [matDatepicker]="picker1" required>
          <mat-datepicker-toggle matSuffix [for]="picker1"></mat-datepicker-toggle>
          <mat-datepicker #picker1></mat-datepicker>
        </mat-form-field>
      </div>

      <div class="row">
        <mat-form-field appearance="outline" style="width:44%">
          <mat-label>Comments</mat-label>
          <textarea name='txtappreciatedComments' maxlength="2000" [(ngModel)]="editItem.comments" matInput (keypress)="numberOnly($event)"
            required></textarea>
        </mat-form-field>
      </div>

      <div class="row">
        <button type="submit" class="btn btn-success" style="width:7%">Save</button>
      </div>
    </div>
  </form>
</div>
