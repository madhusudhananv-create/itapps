<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cache policy override for the "static" subfolder (js + css bundles).

  This file's rules apply to everything under static/ (including static/js and
  static/css, which webpack writes to at build time) and take precedence over the
  parent public/web.config (copied to build/web.config) for anything under this
  subfolder, via normal IIS/ASP.NET config inheritance — no <location> element needed,
  which avoids the "Internal Server Error" caused by using <location> for a specific
  child path in a non-application-root web.config.

  Content-hashed JS/CSS bundles (e.g. main.403ac90e.js) are safe to cache forever:
  a new build always gives them a new filename, so an old cached file is simply never
  referenced again by the new index.html — never served stale.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="public, max-age=31536000, immutable" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
