<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cache policy for index.html (this folder's root).

  IMPORTANT: this file must NOT use <location> elements. /csat-analysis-dashboard is a
  plain subfolder of the main IIS application (not its own registered IIS Application),
  and IIS only allows <location path="..."> targeting a specific child file/folder in
  the application-ROOT web.config — using it here causes an IIS config error
  (Internal Server Error / HTTP 500.19). Instead, this file applies its rules directly
  to "this directory and everything under it", and the more specific
  public/static/web.config (copied to build/static/web.config) overrides them for the
  static/js and static/css subfolders via normal IIS config inheritance.

  Why this matters: index.html is the one file whose name never changes between
  builds, so it must always be revalidated — otherwise browsers keep loading an old
  index.html that still points at the previous (now-stale) bundle filename.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <remove name="Pragma" />
        <add name="Pragma" value="no-cache" />
        <remove name="Expires" />
        <add name="Expires" value="-1" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
