<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ template language="C#" #>
 <#@ assembly name="$(SolutionDir)\GAVS.AllocationSystem.Model\bin\Release\GAVS.AllocationSystem.Model.dll" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
 <#@ import namespace="System.IO" #> 
 <#@ assembly name="System.Core" #>
<#@ import namespace="GAVS.AllocationSystem.Model" #> 
<#@ Assembly Name="EnvDTE" #>
<#@ include file="$(ProjectDir)\T4.FileManager.VisualStudio.ttinclude" #>
 
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>

using GAVS.AllocationSystem.Model.AllSys;
using GAVS.AllocationSystem.Model.AllSys.Tables;
using System;
using System.Collections.Generic;
using System.Data.Entity;
using System.Data.Entity.ModelConfiguration.Conventions;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
            
namespace GAVS.AllocationSystem.Data
{

    public partial class CloudDbContext
    {
        public void CreateModelsFromTemplate(DbModelBuilder modelBuilder)
        {
<# 
            var serviceProvider = this.Host as IServiceProvider;
            var dte = serviceProvider.GetService(typeof(EnvDTE.DTE)) as EnvDTE.DTE;
            var solutionDirectory = System.IO.Path.GetDirectoryName(dte.Solution.FullName);
            Directory.SetCurrentDirectory(solutionDirectory);
          
            List<GAVS.AllocationSystem.Model.TableItem> items = new List<GAVS.AllocationSystem.Model.TableItem>();
             //string filename = Path.Combine(solutionDirectory, "\\GAVS.AllocationSystem.Model\\tables.json");
               string filename =                  Path.GetFullPath(solutionDirectory +  "\\GAVS.AllocationSystem.Model\\tables.json");
            using (StreamReader r = new StreamReader(filename))
            {
                string json = r.ReadToEnd();
                items = JsonConvert.DeserializeObject<List<GAVS.AllocationSystem.Model.TableItem>>(json);
            }
            foreach (var aaa in items)
            {
                string name = aaa.name;

#>
            modelBuilder.Entity<<#= name#>>().ToTable("dbo.<#= name#>");
<#
        }
#>
        }
<#
   foreach (var aaa in items)
   {
        string name = aaa.name;
#>
        public virtual DbSet<<#= name#>> <#= name#> { get; set; }
<#
}
#>
}
}
 